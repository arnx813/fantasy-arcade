# Copy to .env and load it with your process manager (node --env-file=.env server/index.js).
NODE_ENV=production
PORT=8080
PUBLIC_ORIGIN=https://play.example.com
DB_PATH=/var/lib/fantasy-arcade/arcade.db
TRUST_PROXY=1

# Comma-separated ISO country codes refused at registration, betting and launch.
# Fill this from your licence's restricted-territories list.
BLOCKED_COUNTRIES=
COUNTRY_HEADER=cf-ipcountry
ADMIN_EMAILS=

MIN_BET_USD=0
MAX_BET_USD=5000
MAX_PROFIT_USD=50000
AFFILIATE_SHARE=0.10
MIN_WITHDRAWAL_USD=10
WITHDRAW_ROLLOVER=1
KYC_THRESHOLD_USD=2000

# Payments: 'mock' (dev only) or 'gateway' once you implement the adapter in
# server/services/payments.js. Webhook HMAC secret shared with the gateway.
PAYMENTS_PROVIDER=gateway
PAYMENTS_WEBHOOK_SECRET=change-me

# Aggregator seamless wallet HMAC secret. MOCK_PROVIDER=0 disables the demo slots.
AGGREGATOR_SECRET=change-me
MOCK_PROVIDER=0

# Crash: commit to a salt before the first round (e.g. a future Bitcoin block hash
# you announce publicly), and never change it for an existing chain.
CRASH_SALT=change-me
CRASH_CHAIN_LENGTH=100000
